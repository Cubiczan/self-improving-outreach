# Cubiczan self-improving outreach — copy to `.env` and fill locally.
# Never commit real values. GitHub Actions and Vercel should store the same
# names as encrypted secrets / project environment variables.

# --- LLM (CrewAI live mode; omit to stay in mock) ---
# LLM_PROVIDER=boundless|openai (default openai). When boundless, CrewAI/LiteLLM
# use BOUNDLESS_API_KEY + BOUNDLESS_BASE_URL (also copied to OPENAI_API_KEY /
# OPENAI_BASE_URL). Auth is Authorization: Bearer $BOUNDLESS_API_KEY.
# When openai is selected but OPENAI_API_KEY is empty and BOUNDLESS_API_KEY is
# set, Boundless is the fallback.
LLM_PROVIDER=openai
OPENAI_API_KEY=
# CREWAI_MODEL=gpt-4o-mini
CREWAI_VERBOSE=false

# Boundless inference (Sam's credit): https://inference.boundless.network/
# OpenAI-compatible. Do not use api.boundlessapi.com.
BOUNDLESS_API_KEY=
BOUNDLESS_BASE_URL=https://api.inference.boundless.network/v1
# CrewAI default. Other catalog ids: dsv4, qwen3.6, nemotron3-super, kimi-k3
BOUNDLESS_MODEL=glm-5.2

# Force mock even if keys exist, or auto-mock when keys are missing.
MOCK_MODE=true

# --- You.com Search / Contents / Research ---
# Canonical You.com docs use YDC_API_KEY; this project accepts either.
# Direct HTTP fallback when One You is not configured.
YOU_API_KEY=
YDC_API_KEY=

# Research path: auto (One You if ready, else YDC_API_KEY, else mock),
# one (prefer One, fall back), or you (direct key only).
RESEARCH_PROVIDER=auto

# --- One (withone.ai) — preferred when secret/CLI auth + connection keys ---
# one --agent actions execute <platform> <actionId> <connectionKey> -d '{...}'
# Do not hardcode live connection keys in git. Paste yours locally only.
ONE_SECRET=
# ONE_CLI=one
# ONE_CLI_AUTH=          # true = treat CLI as authenticated; false = skip ~/.one probe
# ONE_TIMEOUT_SECONDS=90
ONE_YOU_CONNECTION_KEY=
ONE_DAYTONA_CONNECTION_KEY=
# Optional action-id overrides (defaults are the public You.com / Daytona defs):
# ONE_YOU_SEARCH_ACTION_ID=conn_mod_def::GK9ryNdQKGE::TiwS_VVUSE-wxbKljY4T4g
# ONE_YOU_RESEARCH_ACTION_ID=conn_mod_def::GK9rx6bXINM::MUbK6JMcTwWoiaxT6DmEIQ
# ONE_YOU_CONTENTS_ACTION_ID=
# ONE_DAYTONA_CREATE_SANDBOX_ACTION_ID=conn_mod_def::GMgWX_S6VPA::VxlhHfBWQ4qfa9mXEX2OQQ
# ONE_DAYTONA_START_SANDBOX_ACTION_ID=
# ONE_DAYTONA_LIST_SANDBOX_ACTION_ID=
# ONE_DAYTONA_DELETE_SANDBOX_ACTION_ID=
# ONE_DAYTONA_SANDBOX_PATH_VAR=sandboxIdOrName
# One create-sandbox requires buildInfo.dockerfileContent. Snapshot is optional.
# ONE_DAYTONA_DOCKERFILE=FROM daytonaio/sandbox:latest
# ONE_DAYTONA_SNAPSHOT=ubuntu-4vcpu-8ram-100gb
# Blank ONE_DAYTONA_SNAPSHOT omits snapshot from the create body.

# --- Daytona (sandbox + OTEL tracing; optional) ---
# Sandbox path: auto (One Daytona if ready, else SDK), one, or daytona (SDK only).
SANDBOX_PROVIDER=auto
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_OTEL_ENABLED=false
DAYTONA_SANDBOX_RUNS=false
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=

# --- LiveKit voice follow-up / preference interview (optional) ---
# Keys are only required to host a live AgentSession. Mock CLI + transcript
# ingest work without them.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
# After a successful pipeline draft, ingest a JSON transcript into the Learner.
# Default false. Does not require LiveKit keys; text crew still runs without them.
# When true and LiveKit is configured, a missing transcript runs the
# preference-interview stub (sample transcript → apply_learn_event).
LIVEKIT_FEEDBACK_AUTO=false
# File, or a directory of {lead_id}.json files.
LIVEKIT_TRANSCRIPT_PATH=

# --- ClickUp poll (optional; JSON ingest-clickup still works without a token) ---
# Sales Leads list default: 901716996906. Token is never printed by show-config.
CLICKUP_API_TOKEN=
CLICKUP_LIST_ID=901716996906
CLICKUP_QUEUE_STATUS=Queued

# --- ClickHouse Cloud (omit to use in-memory store) ---
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_SECURE=true
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=outreach

# Local docker-compose ClickHouse (HTTP 8123, no TLS):
# CLICKHOUSE_HOST=localhost
# CLICKHOUSE_PORT=8123
# CLICKHOUSE_SECURE=false
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=localdev
# CLICKHOUSE_DATABASE=outreach

# --- Pipeline behavior ---
HUMAN_GATE_ENABLED=false
# CHP decision lock. Unset = true on live, false in mock. Explicit true/false wins.
# When true, approved_for_scout requires sealed R0 + adversary + named human lock.
# CHP_LOCK_ENABLED=
# CHP_DECISIONS_PATH=chp_decisions.jsonl
DEFAULT_CHANNEL=linkedin
SWARM_CONCURRENCY=5
SWARM_INTERVAL_SECONDS=300
# Mock swarm simulates Scout outcomes so the next batch prefers winning angles.
SIMULATE_OUTCOMES=true
# Opt-in draft→Learner on the live path (MOCK_MODE=false). Default false:
# production learns from real Scout outcomes via `learn`. Set true for demos.
# MOCK_LEARN_OUTCOMES is an alias. swarm --learn-simulated also enables this.
LEARN_ON_DRAFT=false
MOCK_LEARN_OUTCOMES=false
