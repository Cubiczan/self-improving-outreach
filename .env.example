# Cubiczan self-improving outreach — copy to `.env` and fill locally.
# Never commit real values. GitHub Actions and Vercel should store the same
# names as encrypted secrets / project environment variables.

# --- LLM (CrewAI live mode; omit to stay in mock) ---
# LLM_PROVIDER=openai|boundless (default openai). When boundless, CrewAI/LiteLLM
# use BOUNDLESS_API_KEY + BOUNDLESS_BASE_URL (also copied to OPENAI_API_KEY /
# OPENAI_BASE_URL). When openai is selected but OPENAI_API_KEY is empty and
# BOUNDLESS_API_KEY is set, Boundless is the fallback.
LLM_PROVIDER=openai
OPENAI_API_KEY=
# CREWAI_MODEL=gpt-4o-mini
CREWAI_VERBOSE=false

# Boundless OpenAI-compatible inference (Sam has ~$50 credit on boundless.network).
# Default base URL is BoundlessAPI. If the dashboard that issued the credit shows
# a different URL (boundless.network inference), override BOUNDLESS_BASE_URL.
BOUNDLESS_API_KEY=
BOUNDLESS_BASE_URL=https://api.boundlessapi.com/v1
# Mid-tier default; BoundlessAPI catalog may use ids such as gpt-5.4-mini.
# boundless.network inference typically uses glm-5.2:
# BOUNDLESS_BASE_URL=https://api.inference.boundless.network/v1
# BOUNDLESS_MODEL=glm-5.2
BOUNDLESS_MODEL=gpt-4o-mini

# Force mock even if keys exist, or auto-mock when keys are missing.
MOCK_MODE=true

# --- You.com Search / Contents / Research ---
# Canonical You.com docs use YDC_API_KEY; this project accepts either.
YOU_API_KEY=
YDC_API_KEY=

# --- Daytona (sandbox + OTEL tracing; optional) ---
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_OTEL_ENABLED=false
DAYTONA_SANDBOX_RUNS=false
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=

# --- LiveKit voice follow-up / preference interview (optional) ---
# Keys are only required to host a live AgentSession. Mock CLI + transcript
# ingest work without them.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
# After a successful pipeline draft, ingest a JSON transcript into the Learner.
LIVEKIT_FEEDBACK_AUTO=false
# File, or a directory of {lead_id}.json files.
LIVEKIT_TRANSCRIPT_PATH=

# --- ClickHouse Cloud (omit to use in-memory store) ---
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_SECURE=true
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=outreach

# Local docker-compose ClickHouse (HTTP 8123, no TLS):
# CLICKHOUSE_HOST=localhost
# CLICKHOUSE_PORT=8123
# CLICKHOUSE_SECURE=false
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=localdev
# CLICKHOUSE_DATABASE=outreach

# --- Pipeline behavior ---
HUMAN_GATE_ENABLED=false
DEFAULT_CHANNEL=linkedin
SWARM_CONCURRENCY=5
SWARM_INTERVAL_SECONDS=300
SIMULATE_OUTCOMES=true
